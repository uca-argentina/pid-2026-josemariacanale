// Identifiers follow docs/agents/domain.md (ADR 0003).
// Hand-written SQL in the migrations, not expressible here (ADR 0004):
// - no overlapping PENDING or BOOKED Bookings per attending User, Tiempo de preparación included: [prepStartsAt, endsAt) (exclusion constraint)
// - Service name unique in any casing among a Branch's Services not retired
// - Service slug unique per Branch among its Services not retired (partial unique index, ADR 0018)
// - a Service is of a User (personal) or of a Branch, exactly one (check); a Branch's has no Availability, a personal one drops it when dado de baja
// - personal Service name (any casing) and slug unique per User among its Services not retired (partial unique indexes, ADR 0021)
// - one active Employee (deletedAt null) per (userId, businessId): a User can be re-hired after being dado de baja
// - at most one default Availability per User (partial unique index)
// - no overlapping AvailabilityOverride Franjas per (availabilityId, date), half-open, skipping día-libre rows (exclusion constraint)
// - BookingSlug: exactly one of businessId / userId (check), slug lowercase (check) (ADR 0026)
// - Booking.cancelledAt only with status CANCELLED, Booking.rejectedAt only with REJECTED (check)
// - StreakProgram: exactly one of businessId / userId (check), burnAfterDays 1 to 365 (check); StreakReward: requiredCount and validForDays above 0 (check)
// - StreakPrize: exactly one of businessId / userId (check), clientEmail lowercase (check), reachedCount above 0 (check)
// - AvailabilityInterval Franjas of one weekday don't overlap: checked by the API only, since `days` is an array (ADR 0020)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  BOOKED
  REJECTED
  CANCELLED
}

/// Quién hizo que un Turno terminara CANCELLED o REJECTED (ADR 0033).
enum BookingActor {
  EMPLOYEE
  CLIENT
  RETIREMENT
}

/// Por qué se Canceló un Turno cuando lo cancela un cambio en el horario de quien lo atiende (ADR 0034).
enum CancellationCause {
  OUT_OF_OFFICE
  PUBLIC_HOLIDAY
  SCHEDULE_CHANGE
}

/// Proveedor del Calendario conectado (ADR 0036).
enum CalendarProvider {
  GOOGLE
  MICROSOFT
}

/// Estado del Calendario conectado (ADR 0036): DISCONNECTED es una conexión que Google dejó de aceptar.
enum CalendarConnectionStatus {
  CONNECTED
  DISCONNECTED
}

enum ServiceCategory {
  CLINICA
  SPA
  GIMNASIO
  ACADEMIA
  OTRO
}

/// Nivel de una Insignia (CONTEXT.md, Reconocimiento). Una Insignia de un solo Nivel usa BRONZE.
enum BadgeLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum OutOfOfficeReason {
  UNSPECIFIED
  VACATION
  TRAVEL
  SICK_LEAVE
  PUBLIC_HOLIDAY
}

enum StreakRewardType {
  PERCENT_DISCOUNT
  AMOUNT_DISCOUNT
  GIFT
  FREE_SERVICE
}

model User {
  id         Int       @id @default(autoincrement())
  clerkId    String    @unique // Clerk is the identity's system of record; no local credentials
  name       String
  email      String
  slug       String?   @unique // Enlace de reserva del Usuario: /u/<slug>, always lowercase; null until they choose it (ADR 0021)
  imageUrl   String? // foto de perfil: Clerk's, seeded on creation and refreshed from the session token claims
  deletedAt  DateTime? @db.Timestamptz(3) // when dado de baja (ADR 0024); null while active
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  timeFormat Int       @default(24) // preferencia de hora: 12 o 24 h
  weekStart  Int       @default(1) // primer día de la semana, 0 = domingo como dayjs().day()

  businesses            Business[]
  services              Service[]
  bookings              Booking[]
  employees             Employee[]
  availabilities        Availability[]
  bookingSlug           BookingSlug?
  outOfOffices          OutOfOffice[]
  holidaySettings       UserHolidaySettings?
  calendar              CalendarConnection?
  bookingCalendarEvents BookingCalendarEvent[]
  badges                UserBadge[]
  streakProgram         StreakProgram?
  streakPrizes          StreakPrize[]          @relation("StreakPrizeOwner")
  redeemedStreakPrizes  StreakPrize[]          @relation("StreakPrizeRedeemedBy")
}

model Business {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  ownerId     Int       @unique // un Usuario es Dueño de a lo sumo un Negocio (ADR 0012)
  slug        String    @unique // Enlace de reserva: /business/<slug>, always lowercase
  deletedAt   DateTime? @db.Timestamptz(3) // cuándo se dio de baja con su Dueño (ADR 0024); null mientras está activo, también en las filas previas a la migración
  logoUrl     String? // Logo del Negocio en el storage externo (ADR 0015); null si no tiene

  owner         User           @relation(fields: [ownerId], references: [id])
  branches      Branch[]
  employees     Employee[]
  invitations   Invitation[]
  bookingSlug   BookingSlug?
  streakProgram StreakProgram?
  streakPrizes  StreakPrize[]
}

/// Invitaci�n pendiente de un Negocio a un email para ser Empleado (ADR 0019); vence a los 7 d�as.
model Invitation {
  id         Int       @id @default(autoincrement())
  businessId Int
  email      String // always lowercase
  expiresAt  DateTime  @db.Timestamptz(3)
  closedAt   DateTime? @db.Timestamptz(3) // aceptada o rechazada

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, email])
}

model Branch {
  id          Int     @id @default(autoincrement())
  businessId  Int
  name        String
  address     String
  timeZone    String // IANA name (e.g. America/Argentina/Buenos_Aires), never a UTC offset; the only source of time zone in the system
  slug        String // Enlace de reserva's second tramo: /business/<business slug>/<slug>, always lowercase (ADR 0014)
  description String? // shown on the public page instead of the Negocio's own; null = none
  latitude    Float? // Ubicación's point (ADR 0037); both or neither (CHECK Branch_location_both_or_neither), null only on Sucursales from before it existed
  longitude   Float?

  business Business      @relation(fields: [businessId], references: [id])
  services Service[]
  images   BranchImage[]
  cabins   Cabin[]

  @@unique([businessId, slug]) // unique within its Negocio only, unlike Business.slug
}

/// Imagen de Sucursal: the file lives in the external storage (ADR 0015), this row only points to it.
model BranchImage {
  id       Int    @id @default(autoincrement())
  branchId Int
  url      String // public URL the storage handed out; also how the file is deleted from it
  order    Int // ascending; not necessarily contiguous after a delete

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, order])
}

/// Cabina (ADR 0030): espacio o equipo de una Sucursal. The unique (branchId, lower(name)) among the active ones is written by hand in the migration.
model Cabin {
  id        Int       @id @default(autoincrement())
  branchId  Int
  name      String
  deletedAt DateTime? @db.Timestamptz // set = dada de baja; the row stays as history

  branch   Branch         @relation(fields: [branchId], references: [id])
  services ServiceCabin[]
  bookings Booking[]

  @@index([branchId])
}

/// The Cabinas a Servicio del Negocio admits (ADR 0030). Retiring a Cabina deletes its rows.
model ServiceCabin {
  serviceId Int
  cabinId   Int

  service Service @relation(fields: [serviceId], references: [id])
  cabin   Cabin   @relation(fields: [cabinId], references: [id])

  @@id([serviceId, cabinId])
  @@index([cabinId])
}

model Service {
  id                   Int             @id @default(autoincrement())
  branchId             Int? // Servicio del Negocio; null in a Servicio personal (ADR 0021)
  userId               Int? // Servicio personal; null in a Servicio del Negocio
  availabilityId       Int? // the Usuario's own Availability a Servicio personal is attended with; null in a Servicio del Negocio and once dado de baja
  name                 String
  description          String?
  category             ServiceCategory
  durationMinutes      Int
  price                Decimal         @db.Decimal(10, 2)
  depositPercent       Int? // Seña: 0-100, symbolic (never charged); null when the Servicio asks for none
  requiresApproval     Boolean         @default(false) // Aprobación manual: verified Turnos are born PENDING instead of BOOKED
  deletedAt            DateTime?       @db.Timestamptz(3) // when dado de baja; null while offered
  slug                 String // Enlace de reserva's last tramo, always lowercase (ADR 0018)
  hidden               Boolean         @default(false) // Servicio oculto: off the Sucursal's page, reachable only by its own Enlace de reserva
  prepMinutes          Int             @default(0) // Tiempo de preparación: 0, 5, 10, 15, 30 or 60 (checked by the API), held before each Turno
  dailyLimit           Int? // Límite diario: PENDING and BOOKED Turnos per local day of the Sucursal; null when there is none
  slotInterval         Int? // Intervalo: minutes between Horario reservable starts; null means the duration
  minimumNoticeMinutes Int             @default(0) // Anticipación mínima: minutes that must remain before a Turno starts to Reservar it
  repeatEveryWeeks     Int? // Repetición: weeks between the Turnos of a Serie; null with repeatMaxBookings when there is none (CHECK: both or neither)
  repeatMaxBookings    Int? // Repetición: most Turnos a Serie may have, 2 to 10

  branch        Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user          User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  availability  Availability?     @relation(fields: [availabilityId], references: [id], onDelete: Restrict)
  employees     EmployeeService[]
  cabins        ServiceCabin[]
  bookings      Booking[]
  waitlist      WaitlistEntry[]
  streakRewards StreakReward[]
}

model Employee {
  id         Int       @id @default(autoincrement())
  userId     Int
  businessId Int
  deletedAt  DateTime? @db.Timestamptz(3) // when dado de baja; null while employed

  user     User              @relation(fields: [userId], references: [id])
  business Business          @relation(fields: [businessId], references: [id])
  services EmployeeService[]
  bookings Booking[]
}

/// An Empleado attending a Servicio with one of their own Availabilities. A reference: editing that Availability
/// changes every Servicio using it at once. Only between an Empleado and a Servicio not dados de baja.
model EmployeeService {
  employeeId     Int
  serviceId      Int
  availabilityId Int // one of the Empleado's User's own; a Service using it keeps it from being deleted

  employee     Employee     @relation(fields: [employeeId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])
  availability Availability @relation(fields: [availabilityId], references: [id])

  @@id([employeeId, serviceId])
  @@index([serviceId])
  @@index([availabilityId])
}

model Availability {
  id        Int     @id @default(autoincrement())
  userId    Int
  name      String
  timeZone  String // IANA name; its Franjas and Anulaciones are read in this zone, not the Branch's (ADR 0020)
  isDefault Boolean // exactly one per User

  user             User                   @relation(fields: [userId], references: [id])
  intervals        AvailabilityInterval[]
  overrides        AvailabilityOverride[]
  services         EmployeeService[]
  personalServices Service[]
}

/// Franja. Never crosses midnight: endTime is always after startTime.
model AvailabilityInterval {
  id             Int      @id @default(autoincrement())
  availabilityId Int
  days           Int[] // 0 = Sunday … 6 = Saturday, same as dayjs().day()
  startTime      DateTime @db.Time(0) // read by Prisma as 1970-01-01T<HH:mm>Z
  endTime        DateTime @db.Time(0)

  availability Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
}

/// Anulación: replaces an Availability's Franjas for one concrete date, read in its time zone.
/// Both times null is a día libre. Several rows for the same date are that date's own Franjas.
model AvailabilityOverride {
  id             Int       @id @default(autoincrement())
  availabilityId Int
  date           DateTime  @db.Date
  startTime      DateTime? @db.Time(0)
  endTime        DateTime? @db.Time(0)

  availability Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  @@index([availabilityId, date])
}

/// Fuera de la oficina: período de días enteros del Usuario, sin relación con sus Availabilities (ADR 0027).
model OutOfOffice {
  id               Int               @id @default(autoincrement())
  userId           Int
  startDate        DateTime          @db.Date // inclusive, sin hora
  endDate          DateTime          @db.Date // inclusive, sin hora
  reason           OutOfOfficeReason
  notes            String?
  showNotePublicly Boolean           @default(false)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, startDate, endDate]) // dos períodos del Usuario no tienen las mismas fechas
  @@index([userId])
}

model Booking {
  id                  Int                @id @default(autoincrement())
  serviceId           Int
  employeeId          Int? // the Empleado of a Servicio del Negocio; null in a Servicio personal
  userId              Int // the User who attends it: occupancy is per User, across Servicios personales and of any Negocio (ADR 0021)
  cabinId             Int? // the Cabina it occupies from prepStartsAt (ADR 0030); null in a Servicio without Cabinas, and in Turnos taken before it admitted them
  prepStartsAt        DateTime           @db.Timestamptz(3) // startsAt - Service.prepMinutes, fixed at booking: the attending User's agenda is held from here
  startsAt            DateTime           @db.Timestamptz(3)
  endsAt              DateTime           @db.Timestamptz(3) // startsAt + Service.durationMinutes, fixed at booking
  status              BookingStatus // fijado al crear: BOOKED, o PENDING con Aprobación manual (ADR 0022)
  notes               String? // Comentario del Turno, up to 500 characters (checked by the API)
  noShowAt            DateTime?          @db.Timestamptz(3) // Ausencia del Invitado: when the Empleado marked it; never replaces status
  employeeNoShowAt    DateTime?          @db.Timestamptz(3) // Ausencia del Anfitrión: when the Cliente marked it from the Enlace del Turno; never replaces status, and excludes noShowAt (CHECK, ADR 0004)
  link                String?            @unique // Enlace del Turno (ADR 0022): secret, random, URL-safe, generated at creation; Reagendar moves it to the new Turno (ADR 0031), leaving null in the original
  employeeChosen      Boolean            @default(false) // Empleado elegido (ADR 0026): the Cliente came in by this Empleado's Enlace de reserva; Reagendar never moves it to another
  depositAmount       Decimal?           @db.Decimal(10, 2) // Seña pendiente: price × depositPercent / 100 at booking, rounded to the cent; null if the Servicio asked for none. Later changes to the Servicio don't touch it
  depositPaidAt       DateTime?          @db.Timestamptz(3) // Pagar la Seña: when the Cliente paid it; null while pending
  price               Decimal            @db.Decimal(10, 2) // the Servicio's price fixed at booking, like depositAmount; later changes to the Servicio don't touch it
  cancelledAt         DateTime?          @db.Timestamptz(3) // Cancelar: when it was cancelled; only with status CANCELLED (CHECK, ADR 0004)
  rejectedAt          DateTime?          @db.Timestamptz(3) // Rechazar turno: when it was rejected; only with status REJECTED (CHECK, ADR 0004)
  acceptedAt          DateTime?          @db.Timestamptz(3) // Aceptar turno: when it was accepted, or created already BOOKED; null while PENDING (ADR 0033)
  cancelledBy         BookingActor? // who cancelled or rejected it, or Reagendó it in the original; only with status CANCELLED or REJECTED (CHECK, ADR 0004); null in Turnos cancelled before it existed
  cancellationReason  String? // Motivo de cancelación, up to 500 characters (checked by the API); only with cancelledBy (CHECK, ADR 0004)
  cancellationCause   CancellationCause? // Causa de cancelación; only CANCELLED by EMPLOYEE with a cancellationReason (CHECK, ADR 0004)
  rescheduled         Boolean? // Reagendar (ADR 0031): true only in the original, which stays CANCELLED; null otherwise
  fromRescheduleId    Int?               @unique // the original Turno this one replaced; null if it was not born from a Reagendar
  ratingRequestSentAt DateTime?          @db.Timestamptz(3) // Invitación a calificar: when the mail was sent; null while not sent, so each Turno gets one
  seriesId            String?            @db.Uuid // Serie (#303): shared by the Turnos booked together with Repetición; null in a Turno suelto. Reagendar copies it to the new Turno
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)

  service              Service               @relation(fields: [serviceId], references: [id])
  employee             Employee?             @relation(fields: [employeeId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id])
  cabin                Cabin?                @relation(fields: [cabinId], references: [id])
  client               Client?
  fromReschedule       Booking?              @relation("Reschedule", fields: [fromRescheduleId], references: [id])
  rescheduledTo        Booking?              @relation("Reschedule")
  rating               BookingRating?
  calendarEvent        BookingCalendarEvent?
  redeemedStreakPrizes StreakPrize[]

  @@index([seriesId])
}

/// Calificación: el puntaje de 1 a 5 (CHECK, ADR 0004) que el Cliente deja sobre un Turno atendido desde el Enlace del Turno. Una por Turno (índice único) y no se edita.
model BookingRating {
  id        Int      @id @default(autoincrement())
  bookingId Int      @unique
  score     Int
  comment   String? // up to 500 characters (checked by the API); null if left empty
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

/// Cliente (ADR 0022): una fila por Turno, con el nombre con el que se reservó; el mismo email en tres Turnos son tres filas.
model Client {
  id        Int    @id @default(autoincrement())
  bookingId Int    @unique
  name      String
  email     String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([email])
}

/// Primer tramo del Enlace de reserva, de un Negocio o de un Usuario, nunca de los dos (ADR 0026). Un solo espacio de nombres: la clave primaria hace cumplir que ningún Negocio y Usuario compartan slug. La fila queda al dar de baja (ADR 0024).
model BookingSlug {
  slug       String @id // always lowercase
  businessId Int?   @unique
  userId     Int?   @unique

  business Business? @relation(fields: [businessId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
}

/// Caché de Días festivos leídos de Google Calendar (ADR 0027), copiado de cal.diy. Se vuelve a pedir a Google cuando tiene más de 7 días.
model HolidayCache {
  id          String   @id @default(uuid())
  countryCode String
  calendarId  String
  eventId     String
  name        String
  date        DateTime @db.Date
  year        Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryCode, eventId])
  @@index([countryCode, year])
  @@index([countryCode, date])
}

/// Días festivos del Usuario (ADR 0027): el país o calendario religioso que eligió y los Días festivos que apagó.
model UserHolidaySettings {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  countryCode String? // código de `holiday-calendars.ts`; null sin país
  disabledIds String[] // eventId de los Días festivos apagados

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])
}

/// Anotación (ADR 0034): pedido de un Cliente de entrar en la Lista de espera de un Servicio para una fecha. Una sola viva por email (sin mayúsculas), Servicio y fecha (índice único parcial en el SQL de la migración, ADR 0004).
model WaitlistEntry {
  id         Int       @id @default(autoincrement())
  serviceId  Int
  date       DateTime  @db.Date // local day in the Servicio's time zone
  clientName String
  email      String // trimmed and lowercase
  link       String    @unique // secret of the link to Salir de la Lista de espera
  notifiedAt DateTime? @db.Timestamptz(3) // when the Aviso de horario libre went out; null while the day is full
  leftAt     DateTime? @db.Timestamptz(3) // when the Cliente Salió; null while the Anotación is alive
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

/// Las Rachas de un Negocio o de los Servicios personales de un Usuario: uno de los dos, exactamente (CHECK).
model StreakProgram {
  id            Int     @id @default(autoincrement())
  businessId    Int?    @unique
  userId        Int?    @unique
  burnAfterDays Int? // Tiempo de quemada, 1 to 365; null while nobody fixed it (a Recompensa created the program)
  active        Boolean @default(false)

  business Business?      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user     User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  rewards  StreakReward[]
}

/// Recompensa: lo que se gana al llegar a `requiredCount` Turnos de la Racha.
model StreakReward {
  id            Int              @id @default(autoincrement())
  programId     Int
  requiredCount Int
  repeatable    Boolean // true: every requiredCount Turnos; false: once per Racha
  type          StreakRewardType
  value         Decimal?         @db.Decimal(10, 2) // percentage or amount; null in the other types
  description   String? // GIFT only
  serviceId     Int? // FREE_SERVICE only
  validForDays  Int? // how long its Premios last; null when they don't expire
  deletedAt     DateTime?        @db.Timestamptz(3) // set = borrada; the row stays as history

  program StreakProgram @relation(fields: [programId], references: [id])
  service Service?      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  prizes  StreakPrize[]

  @@index([programId])
}

/// Premio: lo que ganó una Ficha del Cliente al llegar su Racha a una Recompensa. Copia lo prometido: editar la Recompensa no lo cambia.
model StreakPrize {
  id                Int              @id @default(autoincrement())
  rewardId          Int
  businessId        Int?
  userId            Int?
  clientEmail       String // lowercase: with the Negocio or the Usuario, the Ficha del Cliente
  streakStartedAt   DateTime         @db.Timestamptz(3) // startsAt of the Racha's first Turno
  reachedCount      Int // the Turnos of the Racha that earned it
  type              StreakRewardType
  value             Decimal?         @db.Decimal(10, 2)
  description       String?
  serviceName       String?
  grantedAt         DateTime         @db.Timestamptz(3)
  expiresAt         DateTime?        @db.Timestamptz(3)
  redeemedAt        DateTime?        @db.Timestamptz(3)
  redeemedBookingId Int?
  redeemedByUserId  Int?

  reward          StreakReward @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  business        Business?    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user            User?        @relation("StreakPrizeOwner", fields: [userId], references: [id], onDelete: Restrict)
  redeemedBooking Booking?     @relation(fields: [redeemedBookingId], references: [id], onDelete: Restrict)
  redeemedBy      User?        @relation("StreakPrizeRedeemedBy", fields: [redeemedByUserId], references: [id], onDelete: Restrict)

  @@unique([rewardId, clientEmail, streakStartedAt, reachedCount])
  @@index([businessId, clientEmail])
  @@index([userId, clientEmail])
}

/// Calendario conectado (ADR 0036): la cuenta de Google o de Microsoft de un Usuario. Una sola por Usuario (unique, ADR 0004).
model CalendarConnection {
  id                    Int                      @id @default(autoincrement())
  userId                Int                      @unique
  provider              CalendarProvider
  email                 String // la cuenta de Google o de Microsoft conectada
  status                CalendarConnectionStatus @default(CONNECTED)
  encryptedRefreshToken String // AES-256-GCM con CALENDAR_TOKEN_KEY; nunca sale en una respuesta ni en un log
  connectedAt           DateTime                 @db.Timestamptz(3)
  checkedCalendarIds    String[]                 @default(["primary"]) // los calendarios que cuentan como Ocupado externo; "primary" es el principal, y [] no lee ninguno (ADR 0038)

  user User @relation(fields: [userId], references: [id])
}

/// Evento del Turno (#401, ADR 0038): el evento que el job escribió en el calendario principal del Usuario que atiende el Turno. Una fila por Turno (índice único); Reagendar la pasa al Turno nuevo. `fingerprint` es lo último que se escribió: si el Turno sigue igual, el job no toca Google (y un evento que el Usuario borró a mano no se recrea).
model BookingCalendarEvent {
  id            Int      @id @default(autoincrement())
  bookingId     Int      @unique
  userId        Int // el Usuario dueño del calendario donde está el evento
  googleEventId String
  fingerprint   String
  syncedAt      DateTime @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([userId, googleEventId])
  @@index([userId])
}

/// Nivel de una Insignia que el Usuario ganó. El catálogo vive en el dominio, por eso `badge` es su clave y no una FK. Nunca se borra: ganado, no se pierde aunque el conteo baje. `seenAt` es null hasta que el Usuario ve el aviso.
model UserBadge {
  id       Int        @id @default(autoincrement())
  userId   Int
  badge    String
  level    BadgeLevel
  earnedAt DateTime   @db.Timestamptz(3)
  seenAt   DateTime?  @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, badge, level])
}

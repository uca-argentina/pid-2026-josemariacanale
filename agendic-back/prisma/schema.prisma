// Identifiers follow docs/agents/domain.md (ADR 0003).
// Hand-written SQL in the migrations, not expressible here (ADR 0004):
// - no overlapping PENDING or BOOKED Bookings per attending User, Tiempo de preparación included: [prepStartsAt, endsAt) (exclusion constraint)
// - Service name unique in any casing among a Branch's Services not retired
// - Service slug unique per Branch among its Services not retired (partial unique index, ADR 0018)
// - a Service is of a User (personal) or of a Branch, exactly one (check); a Branch's has no Availability, a personal one drops it when dado de baja
// - personal Service name (any casing) and slug unique per User among its Services not retired (partial unique indexes, ADR 0021)
// - one active Employee (deletedAt null) per (userId, businessId): a User can be re-hired after being dado de baja
// - at most one default Availability per User (partial unique index)
// - no overlapping AvailabilityOverride Franjas per (availabilityId, date), half-open, skipping día-libre rows (exclusion constraint)
// - AvailabilityInterval Franjas of one weekday don't overlap: checked by the API only, since `days` is an array (ADR 0020)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  BOOKED
  REJECTED
  CANCELLED
}

enum ServiceCategory {
  CLINICA
  SPA
  GIMNASIO
  ACADEMIA
  OTRO
}

model User {
  id        Int      @id @default(autoincrement())
  clerkId   String   @unique // Clerk is the identity's system of record; no local credentials
  name      String
  email     String
  slug      String?  @unique // Enlace de reserva del Usuario: /u/<slug>, always lowercase; null until they choose it (ADR 0021)
  imageUrl  String? // foto de perfil: Clerk's, seeded on creation only; never refreshed after
  deletedAt DateTime? @db.Timestamptz(3) // when dado de baja (ADR 0024); null while active
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  businesses     Business[]
  services       Service[]
  bookings       Booking[]
  employees      Employee[]
  availabilities Availability[]
}

model Business {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  ownerId     Int    @unique // un Usuario es Dueño de a lo sumo un Negocio (ADR 0012)
  slug        String @unique // Enlace de reserva: /business/<slug>, always lowercase
  deletedAt   DateTime? @db.Timestamptz(3) // cuándo se dio de baja con su Dueño (ADR 0024); null mientras está activo, también en las filas previas a la migración
  logoUrl     String? // Logo del Negocio en el storage externo (ADR 0015); null si no tiene

  owner       User         @relation(fields: [ownerId], references: [id])
  branches    Branch[]
  employees   Employee[]
  invitations Invitation[]
}

/// Invitaci�n pendiente de un Negocio a un email para ser Empleado (ADR 0019); vence a los 7 d�as.
model Invitation {
  id         Int       @id @default(autoincrement())
  businessId Int
  email      String // always lowercase
  expiresAt  DateTime  @db.Timestamptz(3)
  closedAt   DateTime? @db.Timestamptz(3) // aceptada o rechazada

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, email])
}

model Branch {
  id         Int      @id @default(autoincrement())
  businessId Int
  name       String
  address    String
  timeZone   String // IANA name (e.g. America/Argentina/Buenos_Aires), never a UTC offset; the only source of time zone in the system
  slug       String // Enlace de reserva's second tramo: /business/<business slug>/<slug>, always lowercase (ADR 0014)

  business Business      @relation(fields: [businessId], references: [id])
  services Service[]
  images   BranchImage[]

  @@unique([businessId, slug]) // unique within its Negocio only, unlike Business.slug
}

/// Imagen de Sucursal: the file lives in the external storage (ADR 0015), this row only points to it.
model BranchImage {
  id       Int    @id @default(autoincrement())
  branchId Int
  url      String // public URL the storage handed out; also how the file is deleted from it
  order    Int // ascending; not necessarily contiguous after a delete

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, order])
}

model Service {
  id               Int             @id @default(autoincrement())
  branchId         Int? // Servicio del Negocio; null in a Servicio personal (ADR 0021)
  userId           Int? // Servicio personal; null in a Servicio del Negocio
  availabilityId   Int? // the Usuario's own Availability a Servicio personal is attended with; null in a Servicio del Negocio and once dado de baja
  name             String
  description      String?
  category         ServiceCategory
  durationMinutes  Int
  price            Decimal         @db.Decimal(10, 2)
  depositPercent   Int? // Seña: 0-100, symbolic (never charged); null when the Servicio asks for none
  requiresApproval Boolean         @default(false) // Aprobación manual: verified Turnos are born PENDING instead of BOOKED
  deletedAt        DateTime?       @db.Timestamptz(3) // when dado de baja; null while offered
  slug             String // Enlace de reserva's last tramo, always lowercase (ADR 0018)
  hidden           Boolean         @default(false) // Servicio oculto: off the Sucursal's page, reachable only by its own Enlace de reserva
  prepMinutes      Int             @default(0) // Tiempo de preparación: 0, 5, 10, 15, 30 or 60 (checked by the API), held before each Turno
  dailyLimit       Int? // Límite diario: PENDING and BOOKED Turnos per local day of the Sucursal; null when there is none
  slotInterval     Int? // Intervalo: minutes between Horario reservable starts; null means the duration
  minimumNoticeMinutes Int @default(0) // Anticipación mínima: minutes that must remain before a Turno starts to Reservar it

  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user         User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  availability Availability?     @relation(fields: [availabilityId], references: [id], onDelete: Restrict)
  employees    EmployeeService[]
  bookings     Booking[]
}

model Employee {
  id         Int       @id @default(autoincrement())
  userId     Int
  businessId Int
  deletedAt  DateTime? @db.Timestamptz(3) // when dado de baja; null while employed

  user     User              @relation(fields: [userId], references: [id])
  business Business          @relation(fields: [businessId], references: [id])
  services EmployeeService[]
  bookings Booking[]
}

/// An Empleado attending a Servicio with one of their own Availabilities. A reference: editing that Availability
/// changes every Servicio using it at once. Only between an Empleado and a Servicio not dados de baja.
model EmployeeService {
  employeeId     Int
  serviceId      Int
  availabilityId Int // one of the Empleado's User's own; a Service using it keeps it from being deleted

  employee     Employee     @relation(fields: [employeeId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])
  availability Availability @relation(fields: [availabilityId], references: [id])

  @@id([employeeId, serviceId])
  @@index([serviceId])
  @@index([availabilityId])
}

model Availability {
  id        Int     @id @default(autoincrement())
  userId    Int
  name      String
  timeZone  String // IANA name; its Franjas and Anulaciones are read in this zone, not the Branch's (ADR 0020)
  isDefault Boolean // exactly one per User

  user      User                   @relation(fields: [userId], references: [id])
  intervals AvailabilityInterval[]
  overrides AvailabilityOverride[]
  services  EmployeeService[]
  personalServices Service[]
}

/// Franja. Never crosses midnight: endTime is always after startTime.
model AvailabilityInterval {
  id             Int      @id @default(autoincrement())
  availabilityId Int
  days           Int[] // 0 = Sunday … 6 = Saturday, same as dayjs().day()
  startTime      DateTime @db.Time(0) // read by Prisma as 1970-01-01T<HH:mm>Z
  endTime        DateTime @db.Time(0)

  availability Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
}

/// Anulación: replaces an Availability's Franjas for one concrete date, read in its time zone.
/// Both times null is a día libre. Several rows for the same date are that date's own Franjas.
model AvailabilityOverride {
  id             Int       @id @default(autoincrement())
  availabilityId Int
  date           DateTime  @db.Date
  startTime      DateTime? @db.Time(0)
  endTime        DateTime? @db.Time(0)

  availability Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  @@index([availabilityId, date])
}

model Booking {
  id                         Int           @id @default(autoincrement())
  serviceId                  Int
  employeeId                 Int? // the Empleado of a Servicio del Negocio; null in a Servicio personal
  userId                     Int // the User who attends it: occupancy is per User, across Servicios personales and of any Negocio (ADR 0021)
  prepStartsAt               DateTime      @db.Timestamptz(3) // startsAt - Service.prepMinutes, fixed at booking: the attending User's agenda is held from here
  startsAt                   DateTime      @db.Timestamptz(3)
  endsAt                     DateTime      @db.Timestamptz(3) // startsAt + Service.durationMinutes, fixed at booking
  status                     BookingStatus // fijado al crear: BOOKED, o PENDING con Aprobación manual (ADR 0022)
  notes                      String? // Comentario del Turno, up to 500 characters (checked by the API)
  noShowAt                   DateTime?     @db.Timestamptz(3) // Ausencia: when the Empleado marked it; never replaces status
  link                       String        @unique // Enlace del Turno (ADR 0022): secret, random, URL-safe, generated at creation
  createdAt                  DateTime      @default(now()) @db.Timestamptz(3)

  service  Service  @relation(fields: [serviceId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  client   Client?
}

/// Cliente (ADR 0022): una fila por Turno, con el nombre con el que se reservó; el mismo email en tres Turnos son tres filas.
model Client {
  id        Int    @id @default(autoincrement())
  bookingId Int    @unique
  name      String
  email     String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([email])
}
